      allow create: if isValidId(announcementId) && isAdmin() && isValidAnnouncement(incoming()) &&
        incoming().authorId == request.auth.uid && incoming().createdAt == request.time;
      allow update: if isValidId(announcementId) && isAdmin() && isValidAnnouncement(incoming()) &&
        incoming().authorId == existing().authorId && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(announcementId) && isAdmin();
    }

    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isVerifiedUser() && isValidId(logId) && isValidAuditLog(incoming()) &&
        incoming().actorId == request.auth.uid && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }

    match /educational_articles/{articleId} {
      allow get: if isValidId(articleId) && (existing().status == 'published' || (isSignedIn() && existing().authorId == request.auth.uid) || isAdmin());
      allow list: if existing().status == 'published' || (isSignedIn() && existing().authorId == request.auth.uid) || isAdmin();
      allow create: if isVerifiedUser() && isValidId(articleId) && isValidArticle(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time &&
        (isAdmin() || isExpertUser());
      allow update: if isVerifiedUser() && isValidId(articleId) && isValidArticle(incoming()) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (isAdmin() || (existing().authorId == request.auth.uid && isExpertUser() && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'cropFocus', 'summary', 'content', 'language', 'status', 'updatedAt'])));
      allow delete: if isVerifiedUser() && isValidId(articleId) && (existing().authorId == request.auth.uid || isAdmin());
    }

    match /expert_questions/{questionId} {
      allow get: if isValidId(questionId) && (existing().isPublic == true || (isSignedIn() && existing().farmerId == request.auth.uid) || isExpertUser() || isAdmin());
      allow list: if existing().isPublic == true || (isSignedIn() && existing().farmerId == request.auth.uid) || isAdmin();
      allow create: if isVerifiedUser() && isValidId(questionId) && isValidExpertQuestion(incoming()) &&
        incoming().farmerId == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(questionId) && isValidExpertQuestion(incoming()) &&
        incoming().farmerId == existing().farmerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (isExpertUser() && existing().status != 'closed' &&
            incoming().expertId == request.auth.uid &&
            incoming().status == 'answered' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['answer', 'expertId', 'expertName', 'status', 'updatedAt'])) ||
          (existing().farmerId == request.auth.uid &&
            incoming().status == 'closed' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );
      allow delete: if isValidId(questionId) && isAdmin();
    }

    match /platform_settings/{settingId} {
      allow get: if isValidId(settingId) && isSignedIn();
      allow list: if isAdmin();
      allow create, update: if isValidId(settingId) && isAdmin() && isValidPlatformSetting(incoming()) && incoming().updatedAt == request.time;
      allow delete: if false;
    }
  }
}
