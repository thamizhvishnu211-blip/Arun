        "action": { "type": "string", "maxLength": 120 },
        "targetCollection": { "type": "string", "maxLength": 80 },
        "targetId": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorId", "action", "targetCollection", "targetId", "createdAt"]
    },
    "EducationalArticle": {
      "title": "EducationalArticle",
      "description": "Agronomy guide or educational content published by agricultural experts or admins.",
      "type": "object",
      "properties": {
        "authorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
