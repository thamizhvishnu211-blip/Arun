# GEMINI_API_KEY: Required for server-side Plant Health AI vision analysis.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OPENWEATHER_API_KEY: Optional. If omitted, AgriSphere uses Open-Meteo live meteorological API.
OPENWEATHER_API_KEY=""
